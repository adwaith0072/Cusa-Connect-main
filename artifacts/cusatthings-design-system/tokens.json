  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": "{typography.fontFamily.body}",
        "$description": "Default UI and body typeface."
      },
      "serif": {
        "$value": "{typography.fontFamily.display}",
        "$description": "Compatibility alias for the condensed display face."
      },
      "display": {
        "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif"],
        "$description": "Condensed display face for expressive headlines and section markers."
      },
      "body": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Friendly geometric sans for interface copy and supporting text."
      },
      "mono": {
        "$value": ["DM Mono", "monospace"],
        "$description": "Technical metadata face for labels, timestamps, and wayfinding."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Compact editorial corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base spacing step for a tight, poster-like rhythm."
    }
  }
