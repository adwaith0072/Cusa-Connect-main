    "$type": "color",
    "light": {
      "background": { "$value": "#e9e4d6", "$description": "Paper-like light canvas." },
      "foreground": { "$value": "#080b12", "$description": "Ink for readable default text." },
      "border": { "$value": "#cfc8b8", "$description": "Quiet warm rule for light surfaces." },
