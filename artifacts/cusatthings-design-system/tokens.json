      "popover": { "$value": "#f2eee3" },
      "popoverForeground": { "$value": "#080b12" },
      "primary": {
        "$value": "#f4a340",
        "$description": "Saffron. The primary signal for action, energy, and wayfinding."
      },
      "primaryForeground": { "$value": "#080b12" },
      "secondary": {
        "$value": "#64b7a6",
        "$description": "Teal. A calm counterpoint for community and place."
      },
      "secondaryForeground": { "$value": "#080b12" },
      "muted": { "$value": "#ddd8ca" },
      "mutedForeground": { "$value": "#55606b" },
      "accent": {
        "$value": "#ed6d54",
