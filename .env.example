# Copy to .env for local use. Never commit real values.

# --- Web app (artifacts/cusatthings) ---
# No variables are required to build or deploy the web app.
# Optional for local dev: PORT=5173  BASE_PATH=/

# --- API server (artifacts/api-server), optional and not deployed by vercel.json ---
PORT=8080
# Comma-separated list of origins allowed to call the API (no wildcard in production).
CORS_ORIGIN=http://localhost:5173
# Only needed once DB-backed routes exist (lib/db).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
